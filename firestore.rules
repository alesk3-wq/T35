rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ⚠️ DESATIVADA TEMPORARIAMENTE em 2026-08-12 a pedido do admin — treinamento no dia
    // seguinte, cadastro liberado por hoje. Trocar pra `true` religa a trava de CPF
    // autorizado (não esquecer — combinado pra reativar amanhã).
    function whitelistCpfAtiva() {
      return false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Qualquer autenticado lê (admin/grupos precisam buscar candidatos).
    // Criação: apenas o próprio usuário, sempre com role 'candidato'.
    // Atualização própria: qualquer campo exceto role e uid (previne auto-promoção).
    // Atualização alheia: permitida para autenticados (necessário para admin/usuarios.html).
    // NOTA: proteção completa de role exige Firebase Custom Claims (melhoria futura).
    match /users/{docId} {
      allow read: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'candidato'
                    // CPF precisa estar na lista de funcionários autorizados e ativo.
                    // cpf == null é o doc-stub criado no primeiro login Google (ainda sem perfil
                    // completo) — a checagem de verdade pro caso Google acontece no update, quando
                    // ele preenche o CPF de fato no perfil.
                    && (
                         !whitelistCpfAtiva()
                         || request.resource.data.cpf == null
                         || (
                              exists(/databases/$(database)/documents/funcionariosAutorizados/$(request.resource.data.cpf))
                              && get(/databases/$(database)/documents/funcionariosAutorizados/$(request.resource.data.cpf)).data.ativo == true
                            )
                       );

      allow update: if isAuth() && (
          // Atualizando o próprio perfil: não pode mudar role nem uid, e se o cpf estiver
          // mudando (inclusive sendo definido pela primeira vez), precisa estar autorizado.
          (resource.data.uid == request.auth.uid
           && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
           && (
                !whitelistCpfAtiva()
                || request.resource.data.cpf == resource.data.cpf
                || request.resource.data.cpf == null
                || (
                     exists(/databases/$(database)/documents/funcionariosAutorizados/$(request.resource.data.cpf))
                     && get(/databases/$(database)/documents/funcionariosAutorizados/$(request.resource.data.cpf)).data.ativo == true
                   )
              ))
          // Atualizando perfil alheio (admin/usuarios.html)
          || resource.data.uid != request.auth.uid
      );

      allow delete: if false;
    }

    // ── cursos ───────────────────────────────────────────────────────────────
    match /cursos/{cursoId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── inscricoes ───────────────────────────────────────────────────────────
    // Leitura: todos autenticados (admin e instrutor precisam ver todas).
    // Criação por candidato: apenas a própria inscrição, status pendente, não obrigatório.
    // Criação por admin/instrutor: para outro candidato (candidatoId != uid do autor).
    // Atualização por candidato: apenas campo presencas na própria inscrição.
    // Atualização por admin/instrutor: qualquer campo em inscrição alheia.
    match /inscricoes/{inscricaoId} {
      allow read: if isAuth();

      allow create: if isAuth() && (
          // Candidato se inscrevendo no catálogo
          (request.resource.data.candidatoId == request.auth.uid
           && request.resource.data.status == 'pendente'
           && request.resource.data.get('obrigatorio', false) == false)
          // Admin/instrutor/grupos criando para outro candidato
          || request.resource.data.candidatoId != request.auth.uid
      );

      allow update: if isAuth() && (
          // Admin/instrutor atualizando inscrição alheia (status, etc.)
          resource.data.candidatoId != request.auth.uid
          // Candidato atualizando apenas presencas/progresso de vídeo na própria inscrição
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presencas', 'updatedAt', 'videoProgresso', 'modulosProgresso', 'avaliado'])
      );

      // Exclusão: só usada pela ferramenta em master.html (cascata ao apagar curso de
      // teste), gate de verdade é client-side (acessoTotal no user), mesmo padrão de
      // proteção que o resto do admin já usa neste arquivo (isAuth() + trava na tela).
      allow delete: if isAuth();
    }

    // ── grupos ───────────────────────────────────────────────────────────────
    match /grupos/{grupoId} {
      allow read, write: if isAuth();
    }

    // ── empresas ─────────────────────────────────────────────────────────────
    // Leitura pública: select de empresas no register.html (página sem auth).
    match /empresas/{empresaId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── equipes / atuacoes ──────────────────────────────────────────────────
    // Mesmo motivo de empresas: selects em register.html, página sem auth.
    match /equipes/{id} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /atuacoes/{id} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── condecorados ─────────────────────────────────────────────────────────
    match /condecorados/{id} {
      allow read, write: if isAuth();
    }

    // ── funcionariosAutorizados ─────────────────────────────────────────────
    // Lista de CPFs autorizados a se cadastrar, mantida pelo admin. Doc ID = CPF (só dígitos).
    // Sem leitura pública de propósito (CPF é dado sensível, diferente de empresas/equipes/atuacoes)
    // — a validação no cadastro usa exists()/get() dentro das rules de `users`, que ignora a regra
    // de leitura desta coleção (acesso privilegiado interno à avaliação da rule).
    match /funcionariosAutorizados/{cpf} {
      allow read, write: if isAuth();
    }

    // ── notificacoes ─────────────────────────────────────────────────────────
    // Create: admin via dashboard. Update/delete bloqueados.
    match /notificacoes/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ── avaliacoes ───────────────────────────────────────────────────────────
    // Avaliação anônima de curso: o documento NÃO guarda candidatoId de propósito,
    // para que nem no banco seja possível saber quem escreveu. A trava contra
    // avaliação duplicada é a flag `avaliado` na inscrição, do lado do candidato.
    // Imutável após criada (mesmo padrão de notificacoes).
    // NOTA: por não haver vínculo com a inscrição, a regra não consegue impedir
    // criação fora do fluxo da tela — é o preço do anonimato real.
    match /avaliacoes/{id} {
      allow read: if isAuth();
      allow create: if isAuth()
                    && request.resource.data.nota is int
                    && request.resource.data.nota >= 1
                    && request.resource.data.nota <= 5;
      allow update, delete: if false;
    }
  }
}
